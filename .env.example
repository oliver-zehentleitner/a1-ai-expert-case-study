# Copy this file to .env and fill in the values you need.
# All variables use the SMS_ prefix to avoid conflicts.
#
# Provider selection is a CLI flag, not an env var:
#   sms-analyze clustering --provider ollama    (default, no key needed)
#   sms-analyze clustering --provider openai
#   sms-analyze clustering --provider azure

# ── Secrets (never commit .env) ──────────────────────────────────────────────
SMS_OPENAI_API_KEY=

SMS_AZURE_OPENAI_API_KEY=
SMS_AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/openai/v1
SMS_AZURE_OPENAI_MODEL=Cohere-embed-v3-multilingual

# ── Optional overrides ────────────────────────────────────────────────────────
SMS_OLLAMA_BASE_URL=http://localhost:11434
SMS_OLLAMA_MODEL=nomic-embed-text
SMS_OPENAI_MODEL=text-embedding-3-small
SMS_LOG_LEVEL=INFO
