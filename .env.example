# Copy this file to .env and fill in your values.
# All variables use the SMS_ prefix to avoid conflicts.

# ── Embedding provider ──────────────────────────────────────────────────────
# Which backend to use for semantic clustering (Task 5).
# Options: ollama | openai | azure
SMS_EMBEDDING_PROVIDER=ollama

# ── Ollama (default — local, no API key required) ───────────────────────────
# Run `scripts/setup_ollama.sh` to install Ollama and pull the model.
SMS_OLLAMA_BASE_URL=http://localhost:11434
SMS_OLLAMA_MODEL=nomic-embed-text

# ── OpenAI ──────────────────────────────────────────────────────────────────
SMS_OPENAI_API_KEY=sk-...
SMS_OPENAI_MODEL=text-embedding-3-small

# ── Azure OpenAI ─────────────────────────────────────────────────────────────
SMS_AZURE_OPENAI_API_KEY=
SMS_AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
SMS_AZURE_OPENAI_DEPLOYMENT=text-embedding-3-small
SMS_AZURE_OPENAI_API_VERSION=2024-05-01-preview

# ── General ──────────────────────────────────────────────────────────────────
SMS_LOG_LEVEL=INFO
